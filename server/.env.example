# Copy this file to server/.env. Keep real credentials out of Git.
# Defaults run locally. Set production only after creating your owner account locally.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
CMS_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:4000,http://localhost:3000,http://localhost:3001,http://localhost:4000
CMS_MEDIA_QUOTA_MB=2048
# Use an absolute directory on persistent storage when deploying:
# CMS_DATA_DIR=/var/lib/blueprint-cms
# CMS_PUBLIC_URL=https://your-domain.example

# Optional real enquiry notifications. Leave empty while using mockups.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# ENQUIRY_TO=
